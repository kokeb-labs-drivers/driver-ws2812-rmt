/**
 * @file ws2812_rmt_version.h
 * @brief WS2812_RMT driver version, generated by CMake from ws2812_rmt_version.h.in.
 * @copyright Copyright (c) 2026 The driver-ws2812-rmt authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/ws2812_rmt_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef WS2812_RMT_VERSION_H
#define WS2812_RMT_VERSION_H

/** Major version: incompatible API changes. */
#define WS2812_RMT_VERSION_MAJOR @WS2812_RMT_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define WS2812_RMT_VERSION_MINOR @WS2812_RMT_VERSION_MINOR@
/** Patch version: fixes. */
#define WS2812_RMT_VERSION_PATCH @WS2812_RMT_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define WS2812_RMT_VERSION_STRING "@WS2812_RMT_VERSION@"

#endif // WS2812_RMT_VERSION_H
